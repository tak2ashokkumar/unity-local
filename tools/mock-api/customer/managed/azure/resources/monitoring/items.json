    {
      "name": "Percentage CPU",
      "key": "azure.vm.percentage_cpu",
      "value_type": 0,
      "unit": "%"
    },
    {
      "name": "Available memory",
      "key": "azure.vm.available_memory_bytes",
      "value_type": 3,
      "unit": "B"
    },
    {
      "name": "Network in total",
      "key": "azure.vm.network_in_total",
      "value_type": 3,
      "unit": "B"
    }
  ],
  "storageAccounts": [
    {
      "name": "Used capacity",
      "key": "azure.storage.used_capacity",
      "value_type": 3,
      "unit": "B"
    },
    {
      "name": "Transactions",
      "key": "azure.storage.transactions",
      "value_type": 3,
      "unit": ""
    }
  ]
}
