{
  "_comment": "Item templates per device_type. The mock route expands them for each monitored device in devices.json (item_id and monitoring are derived per device); not-monitored devices return no items.",
  "baremetal": [
    {
      "name": "CPU utilization",
      "key": "system.cpu.util",
      "unit": "%",
      "value_type": 0,
      "aggregations": [
        "latest",
        "avg",
        "min",
        "max"
      ]
    },
    {
      "name": "Memory utilization",
      "key": "vm.memory.utilization",
      "unit": "%",
      "value_type": 0,
      "aggregations": [
        "latest",
        "avg",
        "min",
        "max"
      ]
    },
    {
      "name": "Disk space used",
      "key": "vfs.fs.size[/,pused]",
      "unit": "%",
      "value_type": 0,
      "aggregations": [
        "latest",
        "avg",
        "min",
        "max"
      ]
    },
    {
      "name": "Network in",
      "key": "net.if.in[eth0]",
      "unit": "bps",
      "value_type": 3,
      "aggregations": [
        "latest",
        "avg",
        "min",
        "max"
      ]
    },
    {
      "name": "System uptime",
      "key": "system.uptime",
      "unit": "s",
      "value_type": 3,
      "aggregations": [
        "latest",
        "avg",
        "min",
        "max"
      ]
    },
    {
      "name": "Load average (1m)",
      "key": "system.cpu.load[all,avg1]",
      "unit": "",
      "value_type": 0,
      "aggregations": [
        "latest",
        "avg",
        "min",
        "max"
      ]
    },
    {
      "name": "Operating system",
      "key": "system.sw.os",
      "unit": "",
      "value_type": 4,
      "aggregations": [],
      "selectable": false
    }
  ],
